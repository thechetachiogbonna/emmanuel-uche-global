# Local Postgres example — swap for your own instance (local Postgres.app /
# Docker, or a hosted provider like Neon, Supabase, Railway, or Render).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/emmanuel_uche_global"

# The account that signs up (or is seeded) with this email becomes an
# admin at login — see lib/session.ts. Keep this address private.
ADMIN_EMAIL="admin@emmanueluche.com"

# Used once by `npm run db:seed` to create that first admin login.
ADMIN_SEED_PASSWORD="change-this-password"

# Paystack — get test-mode keys free at https://dashboard.paystack.com
# (Settings → API Keys & Webhooks). Use the sk_test_... key here; live
# keys (sk_live_...) only after you've gone through Paystack's business
# verification.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional — set this in production if your host's Host header can't be
# trusted (behind certain proxies/CDNs). Used to build the Paystack
# callback URL. Leave unset for local dev.
# NEXT_PUBLIC_APP_URL="https://your-domain.com"
