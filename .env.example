# Local Postgres example — swap for your own instance (local Postgres.app /
# Docker, or a hosted provider like Neon, Supabase, Railway, or Render).
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/uche_fashion"

# A long random string Better Auth uses to sign sessions and tokens.
# Generate one with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-string"

# The account created with this email during seeding is promoted to the
# "admin" role (via Better Auth's admin plugin) — see lib/db/seed/index.ts.
# Role is what actually gates /admin, not this env var by itself.
ADMIN_EMAIL="admin@uchefashion.com"
ADMIN_SEED_PASSWORD="change-this-password"

# Paystack — get test-mode keys free at https://dashboard.paystack.com
# (Settings → API Keys & Webhooks). Use the sk_test_... key here; live
# keys (sk_live_...) only after you've gone through Paystack's business
# verification.
PAYSTACK_SECRET_KEY="sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Optional — set this in production if your host's Host header can't be
# trusted (behind certain proxies/CDNs). Also used as Better Auth's baseURL.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
